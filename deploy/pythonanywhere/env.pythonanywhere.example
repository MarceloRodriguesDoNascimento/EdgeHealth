# EdgeHealth on PythonAnywhere (free Beginner account) - academic demonstration.
# Copy to /home/SEU_USUARIO/EdgeHealth/backend/.env and replace SEU_USUARIO.
# There are no secrets in this file: sessions are random tokens stored as hashes.

# Private, persistent directory outside the repository (four slashes = absolute path).
DATABASE_URL=sqlite:////home/SEU_USUARIO/edgehealth-data/edgehealth.db

# HTTPS is provided by PythonAnywhere on *.pythonanywhere.com.
COOKIE_SECURE=true
# One trusted load balancer in front of the app: real client IP for the login limit.
TRUST_PROXY=1
SESSION_HOURS=8

# Demonstration limits: SQLite sits on a network filesystem and there is 1 web worker.
MONITOR_INTERVAL=60
MONITOR_PACKETS=4
MONITOR_TIMEOUT=1
MONITOR_LEASE_SECONDS=120
OFFLINE_AFTER=3
RECOVERY_AFTER=2
LATENCY_LIMIT_MS=150
LOSS_LIMIT_PCT=5
DIAGNOSTIC_WINDOW_SECONDS=300
STALE_AFTER_SECONDS=240
COLLECTOR_STALE_SECONDS=240
COLLECTOR_MAX_BATCH=200
COLLECTOR_MAX_REQUESTS_PER_MINUTE=60
COLLECTOR_MAX_SAMPLE_AGE_HOURS=24
COLLECTOR_MAX_CLOCK_SKEW_SECONDS=120

TERMS_VERSION=2026-10
# 30 days is the minimum accepted by purge-history; keeps the 512 MiB quota safe.
METRIC_RETENTION_DAYS=30

# Optional AI ("Explicar com IA"). Leave GEMINI_API_KEY empty to keep the feature disabled.
# Fill it ONLY in ~/EdgeHealth/backend/.env on the server, never in this file or in Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
IA_EXPLICACOES_POR_HORA=10

# Relative SQLite paths resolve inside backend/instance.
DATABASE_URL=sqlite:///edgehealth.db
COOKIE_SECURE=false
SESSION_HOURS=8
MONITOR_INTERVAL=30
MONITOR_PACKETS=4
MONITOR_TIMEOUT=1
MONITOR_WORKERS=4
MONITOR_LEASE_SECONDS=120
OFFLINE_AFTER=3
RECOVERY_AFTER=2
LATENCY_LIMIT_MS=150
LOSS_LIMIT_PCT=5
DIAGNOSTIC_WINDOW_SECONDS=300
STALE_AFTER_SECONDS=180

# Remote collectors (see collector/README.md)
COLLECTOR_STALE_SECONDS=180
COLLECTOR_MAX_BATCH=200
COLLECTOR_MAX_REQUESTS_PER_MINUTE=120
COLLECTOR_MAX_SAMPLE_AGE_HOURS=24
COLLECTOR_MAX_CLOCK_SKEW_SECONDS=120
# Privacy and hosting (see docs/LGPD.md and docs/DEPLOY.md)
TERMS_VERSION=2026-10
METRIC_RETENTION_DAYS=180
# Number of trusted reverse proxies in front of the app (0 when accessed directly).
TRUST_PROXY=0
